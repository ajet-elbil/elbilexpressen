# EmailJS credentials for the booking form (https://dashboard.emailjs.com).
#
# Copy this file to .env and replace the three values. Vite inlines VITE_*
# variables at build time, so they must exist when `npm run build` runs;
# the build stops with an explanation if they are missing.
# .env is git-ignored. Never commit real values to this file.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
